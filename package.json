{
  "name": "keeldesk",
  "private": true,
  "version": "0.1.0",
  "description": "Native Windows 11 desktop MCP (Model Context Protocol) runtime spine and developer environment workbench",
  "author": "Leon Zeng",
  "license": "MIT",
  "homepage": "https://github.com/ZengLiangYi/KeelDesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengLiangYi/KeelDesk.git"
  },
  "bugs": {
    "url": "https://github.com/ZengLiangYi/KeelDesk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows-11",
    "tauri",
    "rust",
    "react",
    "developer-tools",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter @keeldesk/env-workbench dev",
    "bindings": "cargo run -p keeldesk --bin export-bindings",
    "typecheck": "pnpm --filter @keeldesk/react typecheck && pnpm --filter @keeldesk/env-workbench typecheck",
    "build": "pnpm bindings && pnpm --filter @keeldesk/react build && pnpm --filter @keeldesk/env-workbench build",
    "preview": "pnpm --filter @keeldesk/env-workbench preview",
    "fmt:rust": "cargo fmt --all",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace",
    "tauri": "pnpm --filter @keeldesk/env-workbench tauri"
  }
}
