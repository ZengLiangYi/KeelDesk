{
  "name": "keeldesk",
  "private": true,
  "version": "0.1.0",
  "description": "Native Windows 11 desktop MCP (Model Context Protocol) runtime spine and developer environment workbench",
  "author": "Leon Zeng",
  "license": "MIT",
  "homepage": "https://github.com/ZengLiangYi/KeelDesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengLiangYi/KeelDesk.git"
  },
  "bugs": {
    "url": "https://github.com/ZengLiangYi/KeelDesk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows-11",
    "tauri",
    "rust",
    "react",
    "developer-tools",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "typecheck": "tsc --noEmit",
    "build": "pnpm bindings && tsc && vite build",
    "preview": "vite preview",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
